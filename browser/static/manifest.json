{
  "manifest_version": 3,
  "name": "cp2",
  "version": "0.1.0",
  "description": "Sends Codeforces / AtCoder samples, contests and submissions to cp2 in VS Code.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "cp2: send this problem to VS Code",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "scripting", "alarms", "offscreen"],
  "host_permissions": ["*://codeforces.com/*", "*://*.codeforces.com/*", "*://atcoder.jp/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*", "*://atcoder.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
